
def oyin():
    yashirin_son = random.randint(1, 100)
    urinishlar = 0
    print("1 dan 100 gacha bo'lgan sonni o'yladim. Topa olasizmi?")

    while True:
        taxmin = int(input("Soningizni kiriting: "))
	        urinishlar += 1

        if taxmin < yashirin_son:
            print("Kattaroq son kiriting!")
        elif taxmin > yashirin_son:
            print("Kichikroq son kiriting!")
        else:
            print(f"Tabriklayman! Siz {urinishlar} ta urinishda topdingiz!")
            break

oyin()
+
